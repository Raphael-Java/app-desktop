<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" prefHeight="300.0" prefWidth="350.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.LoginController">
   <padding>
      <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
   </padding>
   <children>
      <Label text="Acesso ao Sistema">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <VBox spacing="5.0">
         <children>
            <Label text="Usuário" />
            <TextField fx:id="txtUsername" promptText="Digite seu usuário" />
         </children>
      </VBox>
      <VBox spacing="5.0">
         <children>
            <Label text="Senha" />
            <PasswordField fx:id="txtPassword" promptText="Digite sua senha" />
         </children>
      </VBox>
      <Button mnemonicParsing="false" onAction="#onBtLoginAction" prefWidth="120.0" text="Entrar" />
   </children>
</VBox>