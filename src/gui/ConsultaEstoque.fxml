<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="📦 Consulta de Estoque" />
      
      <!-- Barra de Busca -->
      <HBox spacing="10.0">
         <children>
            <TextField promptText="Buscar produto por nome ou código..." HBox.hgrow="ALWAYS" />
            <Button text="Pesquisar" />
         </children>
      </HBox>

      <!-- Tabela de Produtos -->
      <TableView prefHeight="400.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn prefWidth="75.0" text="Código" />
          <TableColumn prefWidth="200.0" text="Produto" />
          <TableColumn prefWidth="100.0" text="Qtd. Estoque" />
          <TableColumn prefWidth="100.0" text="Preço Unit." />
        </columns>
      </TableView>
   </children>
</VBox>