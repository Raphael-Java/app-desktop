<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.DashboardController">
   <children>
      <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
         <content>
            <VBox alignment="TOP_CENTER" spacing="15.0">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>
                  <Label text="Dashboard Geral">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
                  
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <VBox alignment="CENTER" prefHeight="70.0" prefWidth="170.0" style="-fx-background-color: #3498db; -fx-background-radius: 8;">
                           <children>
                              <Label text="Total Vendedores" textFill="WHITE" />
                              <Label fx:id="lblTotalSellers" text="0" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="20.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="70.0" prefWidth="170.0" style="-fx-background-color: #2ecc71; -fx-background-radius: 8;">
                           <children>
                              <Label text="Total Departamentos" textFill="WHITE" />
                              <Label fx:id="lblTotalDepartments" text="0" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="20.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="70.0" prefWidth="200.0" style="-fx-background-color: #e74c3c; -fx-background-radius: 8;">
                           <children>
                              <Label text="Folha Salarial Total" textFill="WHITE" />
                              <Label fx:id="lblTotalPayroll" text="R$ 0,00" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="18.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <PieChart fx:id="pieChartDepartments" maxHeight="250.0" prefHeight="250.0" prefWidth="350.0" title="Vendedores por Departamento" />
                        <BarChart fx:id="barChartSalaries" maxHeight="250.0" prefHeight="250.0" prefWidth="380.0" title="Média Salarial por Depto">
                          <xAxis>
                            <CategoryAxis label="Departamento" side="BOTTOM" />
                          </xAxis>
                          <yAxis>
                            <NumberAxis label="Média (R$)" side="LEFT" />
                          </yAxis>
                        </BarChart>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>